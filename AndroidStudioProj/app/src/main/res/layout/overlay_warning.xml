<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen warning drawn over every app. Plain framework widgets: it is inflated from a Service. -->
<com.danielharton.scamshieldcompanion.BlockingFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/overlay_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="16dp"
        android:background="@drawable/overlay_card_bg"
        android:orientation="vertical"
        android:padding="20dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/overlay_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="⚠"
                android:textColor="@color/scam_red"
                android:textSize="64sp" />

            <TextView
                android:id="@+id/overlay_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/overlay_title"
                android:textColor="@color/scam_red"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/overlay_score"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="@color/muted"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/overlay_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/ink"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/overlay_block_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/ink"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/overlay_from"
                android:textColor="@color/muted"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/overlay_sender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/overlay_phone"
                android:textColor="@color/muted"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/overlay_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/overlay_message"
                android:textColor="@color/muted"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/overlay_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#FFF1F3F6"
                android:padding="12dp"
                android:textColor="@color/ink"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/overlay_flags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:textColor="@color/muted"
                android:textSize="13sp" />

        </LinearLayout>
    </ScrollView>

    <!-- Always visible, outside the scroll area -->
    <ProgressBar
        android:id="@+id/overlay_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="12dp"
        android:max="15000"
        android:progress="0" />

    <Button
        android:id="@+id/overlay_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/overlay_button_bg"
        android:enabled="false"
        android:minHeight="64dp"
        android:padding="14dp"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold" />
    </LinearLayout>
</com.danielharton.scamshieldcompanion.BlockingFrameLayout>
